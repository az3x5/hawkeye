# Copy to .env and fill in real values. Never commit .env.
POSTGRES_USER=faceid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=faceid

FACEID_ENVIRONMENT=local

# Local object storage (MinIO). Speaks the S3 API, so the same adapter serves
# development here and S3 in AWS. Change these before any shared deployment;
# the root credential is the whole store.
MINIO_ROOT_USER=eagleeye
MINIO_ROOT_PASSWORD=change-me-too
# The MinIO web console is off by default: it is an administrative surface
# with no place on a machine that only needs the object API.
MINIO_BROWSER=off
# Which BlobStore serves media: 'filesystem' needs no credentials, 's3' uses
# the MinIO settings above and is what compose sets.
OBJECT_STORE_BACKEND=s3
# Largest single media upload, in bytes. Enforced while reading the body.
MEDIA_MAX_UPLOAD_BYTES=268435456

# Face detection weights (SCRFD). Fetch the file into ./models and pin its
# checksum; the adapter refuses to load anything that does not match.
FACEID_SCRFD_MODEL_SHA256=5838f7fe053675b1c7a08b633df49e7af5495cee0493c7dcf6697200b85b5b91
# Face recognition weights (AdaFace IR-101, WebFace12M).
FACEID_ADAFACE_MODEL_SHA256=2ea535a43877bd3de8091903935c783ce335be66a9f8917fae9a7a18ae4bbf56
# FACEID_ADAFACE_BATCH_SIZE=16

# Detection policy knobs — tune per deployment and population.
# FACEID_SCRFD_SCORE_THRESHOLD=0.5
# FACEID_SCRFD_NMS_IOU_THRESHOLD=0.4
# Set only when running the API outside docker compose:
# FACEID_POSTGRES_DSN=postgresql://faceid:change-me@localhost:5432/faceid
# FACEID_REDIS_DSN=redis://localhost:6379/0
# FACEID_QDRANT_URL=http://localhost:6333
# FACEID_QDRANT_API_KEY=

# Identity decision policy. No defaults exist in code: state them explicitly.
# These are illustrative starting points, NOT validated operating values —
# tune them against your own population before relying on them.
FACEID_DECISION_ACCEPT_THRESHOLD=0.62
FACEID_DECISION_REVIEW_THRESHOLD=0.42
FACEID_DECISION_POLICY_VERSION=local-dev-v1

# How long a submitted identification image is kept. The identification record
# and its content hash outlive the image, so decisions stay auditable.
FACEID_QUERY_IMAGE_RETENTION_DAYS=30

# Rate limits, per credential per window. Tune to how your deployment is used.
FACEID_RATE_LIMIT_WINDOW_SECONDS=60
FACEID_RATE_LIMIT_IDENTIFY=30
FACEID_RATE_LIMIT_ENROL=120

# Durable processing policy. PostgreSQL owns jobs; leases fence stale workers,
# and bounded exponential retries end in dead-letter state for operator review.
FACEID_JOB_LEASE_SECONDS=300
FACEID_JOB_POLL_INTERVAL_SECONDS=0.5
FACEID_JOB_MAX_ATTEMPTS=3
FACEID_JOB_RETRY_BASE_SECONDS=5
FACEID_JOB_RETRY_MAX_SECONDS=300

# Default lifetime applied to newly issued credentials.
FACEID_TOKEN_LIFETIME_DAYS=90

# Multilingual semantic embeddings. Pin the deployment's exact model revision
# in LANGUAGE_EMBEDDING_VERSION; a controlled host may use a mounted local path.
LANGUAGE_EMBEDDING_MODEL=alakxender/e5-dhivehi-combined-mnr
LANGUAGE_EMBEDDING_VERSION=65ead4fb4e6c5f72ef08eeed13eb2006bfa5f7ad
LANGUAGE_EMBEDDING_DEVICE=cpu
LANGUAGE_EMBEDDING_BATCH_SIZE=8

# Specialist translation, neural transliteration, speech and OCR run in a
# serialized sidecar so only one large model occupies RAM at a time.
DHIVEHI_AI_DEVICE=cpu
DHIVEHI_AI_TORCH_THREADS=8
# Private conversational model served by the internal Ollama container. Pull
# this tag into the ollama-models volume before enabling the bot in production.
DHIVEHI_AI_BOT_MODEL=qwen3:4b
DHIVEHI_AI_BOT_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=5m
# Use the local application build as the base for its CUDA runtime layer. A
# published deployment can instead set this to its exact GHCR image tag.
GPU_BASE_IMAGE=hawkeye-api:dev

# Mark the session cookie Secure. Leave true wherever TLS terminates in front
# of the app. Set false only when the transport is encrypted by something else
# — a WireGuard/Tailscale network — because a browser silently discards a
# Secure cookie over plain HTTP and sign-in then appears to do nothing.
HAWKEYE_COOKIE_SECURE=true
